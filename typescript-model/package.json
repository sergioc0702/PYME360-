{
  "name": "pyme360-typescript-model",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write src README.md index.html vite.config.ts package.json tsconfig.json public/receipt-reader.js",
    "format:check": "prettier --check src README.md index.html vite.config.ts package.json tsconfig.json public/receipt-reader.js",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint src tests"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "minimatch": "^11.0.5"
  }
}
