# Central cloud API; use a managed PostgreSQL service in production.
# development only works with a localhost PUBLIC_BASE_URL. Any other address uses
# the production rules, which never show reset or verification links in responses.
APP_ENV=development
POSTGRES_PASSWORD=pyme360-local-only
DATABASE_URL=postgresql://pyme360:pyme360-local-only@postgres:5432/pyme360
PUBLIC_BASE_URL=http://127.0.0.1:8000

# SMTP is required for registration, verification, invitations and password recovery in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Pyme360 <no-reply@example.com>

# Electronic invoicing runs in the local server; see ../.env.example.
# The shared API intentionally stores only draft tax documents.
