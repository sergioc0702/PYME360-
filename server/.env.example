# Optional electronic-invoicing connector for the local Pyme360 server.
# Copy this file to server/.env, fill the values and restart the local server.
# Never commit server/.env: it contains the provider API key.
#
# The connector is vendor-neutral: it sends the draft snapshot as JSON to the
# documented endpoint of a certified technology provider. That provider remains
# responsible for the UBL XML, the DIAN signature and the numbering response.
PYME360_EINVOICE_PROVIDER=http
PYME360_EINVOICE_BASE_URL=https://sandbox.proveedor.example
PYME360_EINVOICE_API_KEY=
PYME360_EINVOICE_ENVIRONMENT=test
PYME360_EINVOICE_SUBMIT_PATH=/api/v1/documents
PYME360_EINVOICE_STATUS_PATH=/api/v1/documents/{reference}
PYME360_EINVOICE_TIMEOUT_SECONDS=20

# The identifier in PYME360_EINVOICE_PROVIDER must match the "Identificador del
# proveedor" saved in Pyme360 -> Ventas -> Configuración tributaria.
# Use PYME360_EINVOICE_ENVIRONMENT=production only with an HTTPS endpoint.
